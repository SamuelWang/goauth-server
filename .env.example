# Application information
APP_NAME="Go Auth Service"
APP_VERSION=0.1.0
APP_ENV=development   # development | production | test
PORT=8080
GIN_MODE=debug

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSLMODE=disable    # disable | require | verify-ca | verify-full

# Notes:
# - Copy this file to .env and fill values locally.
# - Never commit real secrets. Add .env to .gitignore.
# - Use secure secret managers in production where possible.
