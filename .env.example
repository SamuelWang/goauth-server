# ─── Application configuration ───────────────────────────────────────────────
# Copy this file to .env and fill in the required values.
#
# Docker Compose note:
#   When running with `docker compose up`, the compose file overrides DB_HOST
#   to "postgres" (the service name) automatically — you do not need to change
#   DB_HOST here for that workflow. All other variables are read from this file
#   by Docker Compose.
#
APP_NAME="GoAuth Service"
VERSION=0.2.0

# ─── Server configuration ─────────────────────────────────────────────────────
ENV=development   # development | production | test
SCHEME=http    # http | https
HOST=localhost
PORT=8080

# ─── Database configuration ───────────────────────────────────────────────────
# DB_HOST should be "localhost" for local development.
# Docker Compose overrides this to "postgres" (the service name) internally.
DB_HOST=localhost
DB_PORT=5432
DB_USER=goauth
DB_PASSWORD=
DB_NAME=goauth
DB_SSLMODE=disable    # disable | require | verify-ca | verify-full

# ─── Access Token Configuration ───────────────────────────────────────────────
# To generate ES256 (ECDSA P-256) keys, run:
# openssl ecparam -name prime256v1 -genkey -noout -out ec-private.pem
# openssl ec -in ec-private.pem -pubout -out ec-public.pem
# Then copy the contents (including BEGIN/END markers) as multi-line strings
ACCESS_TOKEN_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----
Your private key here (multi-line)
-----END EC PRIVATE KEY-----"
ACCESS_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
Your public key here (multi-line)
-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRY_MINUTES=60

# ─── Security Configuration ───────────────────────────────────────────────────
# Both keys must be exactly 64 hex characters (32 bytes). Generate each with:
#   openssl rand -hex 32
# They MUST be different values — each key serves a distinct cryptographic purpose.
#
# PROVIDER_ENCRYPTION_KEY: AES-256-GCM encryption of OAuth provider client secrets at rest.
PROVIDER_ENCRYPTION_KEY=
#
# SESSION_SIGNING_KEY: HMAC-SHA256 signing of OAuth web-flow session cookies.
SESSION_SIGNING_KEY=
#
# CORS_ALLOWED_ORIGINS: Comma-separated list of origins permitted to make
# cross-origin requests (e.g. your SPA or admin UI).
# - Leave blank in development to allow all origins via wildcard (*).
# - In production, always set this explicitly; an empty value blocks all
#   cross-origin requests.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# ─── Bootstrap Configuration ──────────────────────────────────────────────────
# These variables control first-run seeding of a default admin account and a
# default OAuth client.  Leave them blank (or unset) to disable bootstrapping.
#
# SECURITY: Bootstrap is intentionally blocked in production unless explicitly
# opted-in with ALLOW_DEFAULT_ADMIN=true / ALLOW_DEFAULT_CLIENT=true.
# Rotate all bootstrap credentials immediately after first login.

# Default admin account
ALLOW_DEFAULT_ADMIN=false        # Set "true" to enable (required in production)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=          # Must satisfy the full password policy

# Default OAuth client
ALLOW_DEFAULT_CLIENT=false       # Set "true" to enable (required in production)
DEFAULT_CLIENT_ID=
DEFAULT_CLIENT_SECRET=           # Plaintext — hashed with SHA-256 before storage
DEFAULT_CLIENT_REDIRECT_URIS=    # Comma-separated list of allowed redirect URIs
DEFAULT_CLIENT_NAME="GoAuth Client"
DEFAULT_CLIENT_CONFIDENTIAL=true # Set "false" for public (SPA/mobile) clients

# ─── Monitoring Configuration ─────────────────────────────────────────────────
# Grafana admin credentials (used by the grafana Docker Compose service).
# Change these from the defaults before deploying to any shared environment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Notes:
# - Copy this file to .env and fill values locally.
# - Never commit real secrets. Add .env to .gitignore.
# - Use secure secret managers in production where possible.
# - In production, set ENV=production and use HTTPS
#
# Docker Compose quick-start:
#   1. cp .env.example .env
#   2. Generate required keys (see sections above) and fill them in .env.
#   3. docker compose up --build
#   4. The migrate service runs all pending migrations, then the server starts.
#   5. API is available at http://localhost:${PORT:-8080}
#   6. Ops health check: http://localhost:${PORT:-8080}/ops/health
#   7. Metrics endpoint: http://localhost:${PORT:-8080}/metrics
#   8. Prometheus UI: http://localhost:9090
#   9. Grafana dashboard: http://localhost:3000
